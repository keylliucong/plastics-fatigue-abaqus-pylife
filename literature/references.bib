@article{naga_fatigue_2024,
	title = {Fatigue {Failure} in {Polymeric} {Materials}: {Insights} from {Experimental} {Testing}},
	volume = {24},
	issn = {1547-7029},
	url = {https://doi.org/10.1007/s11668-024-01874-1},
	doi = {10.1007/s11668-024-01874-1},
	abstract = {AbstractThe investigation of fatigue failure in polymeric materials subjected to cyclic loading holds significant importance across diverse engineering applications. Numerous variables influence material behavior, encompassing material-related factors such as composition, molecular weight, orientation, and additives, as well as external factors like applied stress magnitude (stress amplitude, dynamic stress frequency and mean stress), and operating temperature. This paper presents an experimental exploration into the impact of loading parameters—mean stress, stress amplitude, and dynamic stress frequency—on the failure modes of two thermoplastic materials: high-density polyethylene (HDPE) and polyvinyl chloride (PVC). The study begins with an assessment of the mechanical and physical properties of the materials, followed by the design and manufacturing of a specialized uniaxial fatigue test rig. Tensile–tensile fatigue tests incorporating positive mean stress are conducted, evaluating the influence of altering stress amplitude and frequency on fatigue life and failure mode. The outcomes reveal that HDPE primarily experiences thermal and creep failure modes, with a lack of observed fatigue failure. Conversely, PVC specimens manifest three distinct failure modes: ductile, creep, and fatigue, with the type of failure contingent upon loading parameters. These findings offer significant insights into the various fatigue failure modes and contribute to an enhanced comprehension of the intricate interplay between loading dynamics and failure modes in polymeric materials.},
	number = {2},
	journal = {Journal of Failure Analysis and Prevention},
	publisher = {Springer Science and Business Media LLC},
	author = {Naga, Soheir A. R. and El-Sayed, T. A.},
	month = feb,
	year = {2024},
	keywords = {不限PC-ABS, 塑胶件方法论, 摘要级筛选},
	pages = {922--935},
	annote = {方法论评注｜用途、证据与适用边界检索日期：2026-11-15。
方法用途：从聚合物循环试验考察失效、应力参数与频率的影响，作为试验设计和失效机理入口。当前依据出版商摘要筛选；不能把概括性结论当作全部塑胶通用参数。},
	annote = {全文获取记录｜2026-11-15已从Springer出版社下载正式全文PDF，14页；核对首页题名、作者和DOI 10.1007/s11668-024-01874-1。已导入Zotero附件。本记录确认全文已获取，不代表全文已完成精读。},
